* text=auto eol=lf
# Large bioinformatics data are always stored through Git LFS.
*.bed filter=lfs diff=lfs merge=lfs -text
*.bim filter=lfs diff=lfs merge=lfs -text
*.fam filter=lfs diff=lfs merge=lfs -text
*.vcf.gz filter=lfs diff=lfs merge=lfs -text
*.bcf filter=lfs diff=lfs merge=lfs -text
*.pgen filter=lfs diff=lfs merge=lfs -text
*.pvar filter=lfs diff=lfs merge=lfs -text
*.psam filter=lfs diff=lfs merge=lfs -text
*.bam filter=lfs diff=lfs merge=lfs -text
*.cram filter=lfs diff=lfs merge=lfs -text
*.jf filter=lfs diff=lfs merge=lfs -text
*.gz binary
*.png binary
*.pdf binary
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.fa filter=lfs diff=lfs merge=lfs -text
