        ],
    output:
        filtered=f"{RESULTS}/04_oligominer/by_chrom/{{chrom}}/blockparse.flt.kmer.bed",
        status=f"{RESULTS}/04_oligominer/by_chrom/{{chrom}}/selection_probe_status.tsv",
