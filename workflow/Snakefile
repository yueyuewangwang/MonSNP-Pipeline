rule gather_frequencies:
    input:
        AFREQ_SHARDS
    output:
        AFREQ
    run:
        concatenate_files(input, output[0], headered=True)


rule gather_ld_tag_sets:
    input:
        tags=LD_SHARDS,
        summaries=LD_SUMMARY_SHARDS,
    output:
        tags=LD_TAG_SETS,
        summary=f"{RESULTS}/00_plink/window_ld_tag_sets.summary.json",
    run:
        concatenate_files(input.tags, output.tags)
        parts = []
        for chrom, path in zip(TARGET_CHROMS, map(str, input.summaries)):
            with open(path, encoding="utf-8") as handle:
                item = json.load(handle)
            item["chromosome"] = chrom
            parts.append(item)
        summary = {
            "method": "chromosome-scattered PLINK 1.9 --show-tags LD tag sets"
                      if GENOTYPE_SOURCE == "plink_bfile"
                      else "chromosome-partitioned precomputed LD tag sets",
            "target_chromosomes": TARGET_CHROMS,
            "windows": sum(item.get("windows", 0) for item in parts),
            "windows_without_ld_tag_sets": sum(
                item.get("windows_without_ld_tag_sets", 0) for item in parts
            ),
            "ld_tag_sets_total": sum(item.get("ld_tag_sets_total", 0) for item in parts),
            "chromosome_summaries": parts,
        }
        for key in (
            "bfile_prefix", "plink_executable", "plink_version", "bfile_variants",
            "bfile_samples", "parameters",
        ):
            values = [item[key] for item in parts if key in item]
            if values:
                if any(value != values[0] for value in values[1:]):
                    raise WorkflowError(f"Inconsistent {key} across LD chromosome shards")
                summary[key] = values[0]
        Path(str(output.summary)).parent.mkdir(parents=True, exist_ok=True)
        Path(str(output.summary)).write_text(
            json.dumps(summary, indent=2) + "\n", encoding="utf-8"
        )


if CUSTOM_TRACKS:
    rule weighted_region_manifest:
        input:
            [track["path"] for track in CUSTOM_TRACKS]
        output:
            WEIGHTED_MANIFEST
        run:
            Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
            with open(output[0], "w", encoding="utf-8") as handle:
                handle.write("name\tpath\tweight\n")
                for track in CUSTOM_TRACKS:
                    handle.write(
                        f"{track['name']}\t{os.path.abspath(track['path'])}"
                        f"\t{track['weight']}\n"
                    )


