rule score_candidates:
    input:
        windows=TARGET_WINDOWS,
        ld_tag_sets=LD_TAG_SETS,
        maf=AFREQ,
        annotation=VEP_SCORES if INCLUDE_VEP else [],
        con200m=INPUTS["conserved_200m"] if PROFILE == "study" else [],
        con100v=INPUTS["conserved_100v"] if PROFILE == "study" else [],
        qtl=INPUTS["qtl"] if PROFILE == "study" else [],
        literature=INPUTS["literature"] if PROFILE == "study" else [],
        expression=INPUTS["expression"] if PROFILE == "study" else [],
        local_core=INPUTS["local_adaptation"] if PROFILE == "study" else [],
        pur_core=INPUTS["pur_local_adaptation"] if PROFILE == "study" else [],
        domestication_core=INPUTS["domestication"] if PROFILE == "study" else [],
        weighted=WEIGHTED_MANIFEST if CUSTOM_TRACKS else [],
        weights=config["weights"],
    output:
        scores=f"{RESULTS}/02_scoring/snp_filter_snp_scores.tsv",
        best=f"{RESULTS}/02_scoring/snp_filter_important_ld_tag_set_snp.tsv",
        candidates=f"{RESULTS}/02_scoring/selection_ld_tag_set_candidates.tsv",
        status=f"{RESULTS}/02_scoring/snp_filter_window_status.tsv",
        affected=f"{RESULTS}/02_scoring/selection_affected_windows.tsv",
        candidate_bed=f"{RESULTS}/02_scoring/selection_candidates.bed",
        summary=f"{RESULTS}/02_scoring/score_filter_chip_summary.json",
    params:
        outdir=f"{RESULTS}/02_scoring",
        top=PARAMS.get("candidates_per_window", 10),
        profile=PROFILE,
        study_flags=STUDY_FLAGS,
        annotation_flag=("--annotation " + shlex.quote(VEP_SCORES)) if INCLUDE_VEP else "",
        weighted_flag=("--weighted-regions " + shlex.quote(WEIGHTED_MANIFEST)) if CUSTOM_TRACKS else "",
        aggregation=SCORING.get("region_aggregation", "sum"),
        maf_flag="" if SCORING.get("include_maf", True) else "--disable-maf-score",
        current_flag=("--current-sites " + shlex.quote(INPUTS["current_sites"]))
                     if INPUTS.get("current_sites", "") else "",
        exclude=" ".join(
            "--exclude-chrom " + shlex.quote(value)
            for value in PARAMS.get("exclude_chromosomes", [])
        ),
    log:
        f"{RESULTS}/logs/score_candidates.log",
    conda:
        "envs/core.yaml"
    shell:
        "python {SCRIPTS:q}/score_candidates.py "
        "--windows {input.windows:q} --ld-tag-sets {input.ld_tag_sets:q} "
        "--maf {input.maf:q} --weights {input.weights:q} "
        "--outdir {params.outdir:q} --top-per-window {params.top} "
        "--profile {params.profile:q} --region-aggregation {params.aggregation:q} "
        "{params.annotation_flag} {params.study_flags} {params.weighted_flag} "
        "{params.maf_flag} {params.current_flag} {params.exclude} "
        "> {log:q} 2>&1"


rule prepare_probe_candidates_by_chrom:
    input:
        candidates=rules.score_candidates.output.candidates,
        reference=INPUTS["reference"],
        fai=INPUTS["reference_fai"],
    output:
        table=f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.tsv",
        fasta=f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.fa",
        bed=f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.bed",
        sites=f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_sites.bed",
        summary=f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/prepare_summary.tsv",
    params:
        outdir=lambda wildcards: f"{RESULTS}/03_probe_candidates/by_chrom/{wildcards.chrom}",
        chrom=lambda wildcards: wildcards.chrom,
        rank=PARAMS.get("candidates_per_window", 10),
        left=PARAMS.get("flank_left", 121),
        right=PARAMS.get("flank_right", 120),
    log:
        f"{RESULTS}/logs/prepare_probe_candidates/{{chrom}}.log",
    conda:
        "envs/core.yaml"
    shell:
        "mkdir -p $(dirname {log:q}) && "
        "python {SCRIPTS:q}/prepare_oligominer_candidates.py "
        "--candidates {input.candidates:q} --reference {input.reference:q} --fai {input.fai:q} "
        "--outdir {params.outdir:q} --chromosome {params.chrom:q} "
        "--max-rank {params.rank} --flank-left {params.left} --flank-right {params.right} "
        "> {log:q} 2>&1"


rule gather_probe_candidates:
    input:
        table=expand(
            f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.tsv",
            chrom=TARGET_CHROMS,
        ),
        fasta=expand(
            f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.fa",
            chrom=TARGET_CHROMS,
        ),
        bed=expand(
            f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_flanks.bed",
            chrom=TARGET_CHROMS,
        ),
        sites=expand(
            f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/oligominer_candidate_sites.bed",
            chrom=TARGET_CHROMS,
        ),
        summaries=expand(
            f"{RESULTS}/03_probe_candidates/by_chrom/{{chrom}}/prepare_summary.tsv",
            chrom=TARGET_CHROMS,
        ),
    output:
        table=f"{RESULTS}/03_probe_candidates/oligominer_candidate_flanks.tsv",
        fasta=f"{RESULTS}/03_probe_candidates/oligominer_candidate_flanks.fa",
        bed=f"{RESULTS}/03_probe_candidates/oligominer_candidate_flanks.bed",
        sites=f"{RESULTS}/03_probe_candidates/oligominer_candidate_sites.bed",
        summary=f"{RESULTS}/03_probe_candidates/prepare_summary.tsv",
    run:
        concatenate_files(input.table, output.table, headered=True)
        concatenate_files(input.fasta, output.fasta)
        concatenate_files(input.bed, output.bed)
        concatenate_files(input.sites, output.sites)
        merge_count_tables(
            input.summaries,
            output.summary,
            constant_metrics=("flank_left", "flank_right"),
        )


