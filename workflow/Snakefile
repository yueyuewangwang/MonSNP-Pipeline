STUDY_FLAGS = ""
if PROFILE == "study":
    STUDY_FLAGS = " ".join([
        "--con200m " + shlex.quote(INPUTS["conserved_200m"]),
        "--con100v " + shlex.quote(INPUTS["conserved_100v"]),
        "--qtl " + shlex.quote(INPUTS["qtl"]),
