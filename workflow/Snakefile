            f"{RESULTS}/00_plink/by_chrom/{{chrom}}/variants.afreq"
        params:
            bfile=BFILE,
            prefix=lambda wildcards: f"{RESULTS}/00_plink/by_chrom/{wildcards.chrom}/variants",
