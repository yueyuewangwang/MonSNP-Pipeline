        outdir=lambda wildcards: f"{RESULTS}/04_oligominer/by_chrom/{wildcards.chrom}",
        index=f"{RESULTS}/04_oligominer/shared/reference_index",
        jellyfish=f"{RESULTS}/04_oligominer/shared/reference.25mer.jf",
    threads:
        PARAMS.get("threads", 4)
    log:
        f"{RESULTS}/logs/oligominer/{{chrom}}.log",
    conda:
        "envs/oligominer-legacy.yaml"
    shell:
        "mkdir -p $(dirname {log:q}) && "
        "bash {SCRIPTS:q}/run_oligominer.sh --input-dir {params.input_dir:q} "
        "--reference {input.reference:q} --outdir {params.outdir:q} "
        "--oligominer {VENDOR_OLIGO:q} --python python --threads {threads} "
        "--index {params.index:q} --jellyfish {params.jellyfish:q} > {log:q} 2>&1"


rule gather_oligominer_results:
    input:
        filtered=expand(
            f"{RESULTS}/04_oligominer/by_chrom/{{chrom}}/blockparse.flt.kmer.bed",
            chrom=TARGET_CHROMS,
        ),
        status=expand(
            f"{RESULTS}/04_oligominer/by_chrom/{{chrom}}/selection_probe_status.tsv",
            chrom=TARGET_CHROMS,
        ),
        summaries=expand(
            f"{RESULTS}/04_oligominer/by_chrom/{{chrom}}/selection_probe_status.summary.tsv",
            chrom=TARGET_CHROMS,
        ),
    output:
        filtered=f"{RESULTS}/04_oligominer/blockparse.flt.kmer.bed",
        status=f"{RESULTS}/04_oligominer/selection_probe_status.tsv",
        status_summary=f"{RESULTS}/04_oligominer/selection_probe_status.summary.tsv",
    run:
        concatenate_files(input.filtered, output.filtered)
        concatenate_files(input.status, output.status, headered=True)
        merge_count_tables(
            input.summaries, output.status_summary, header=("status", "count")
        )


rule select_probe_designs:
    input:
        candidates=rules.gather_probe_candidates.output.table,
        filtered=rules.gather_oligominer_results.output.filtered,
    output:
        all=f"{RESULTS}/05_probe_selection/missing_probe_designs.all.tsv",
        strict=f"{RESULTS}/05_probe_selection/missing_probe_designs.strict.tsv",
        rescue=f"{RESULTS}/05_probe_selection/missing_probe_designs.rescue.tsv",
        summary=f"{RESULTS}/05_probe_selection/missing_probe_designs.summary.tsv",
    params:
        outdir=f"{RESULTS}/05_probe_selection",
    log:
        f"{RESULTS}/logs/select_probe_designs.log",
    conda:
        "envs/core.yaml"
    shell:
        "python {SCRIPTS:q}/select_probe_designs.py --candidates {input.candidates:q} "
        "--filtered-bed {input.filtered:q} --outdir {params.outdir:q} > {log:q} 2>&1"


rule assemble_panel:
    input:
        candidates=rules.score_candidates.output.candidates,
        designs=rules.select_probe_designs.output.strict,
    output:
        panel=f"{RESULTS}/06_final_panel/final_strict_probe_panel.tsv",
        bed=f"{RESULTS}/06_final_panel/final_strict_probe_panel.bed",
        unresolved=f"{RESULTS}/06_final_panel/unresolved_windows.tsv",
        summary=f"{RESULTS}/06_final_panel/summary.json",
        report=f"{RESULTS}/06_final_panel/summary_report.txt",
    conda:
        "envs/core.yaml"
    shell:
        "python {SCRIPTS:q}/assemble_panel.py --candidates {input.candidates:q} "
        "--strict-designs {input.designs:q} --output {output.panel:q} --bed {output.bed:q} "
        "--unresolved {output.unresolved:q} --summary {output.summary:q} "
        "--summary-report {output.report:q}"


rule validate_panel:
    input:
        panel=rules.assemble_panel.output.panel,
        reference=INPUTS["reference"],
        fai=INPUTS["reference_fai"],
    output:
        f"{RESULTS}/06_final_panel/validation.json",
    conda:
        "envs/core.yaml"
    shell:
        "python {SCRIPTS:q}/validate_panel.py --panel {input.panel:q} "
        "--reference {input.reference:q} --fai {input.fai:q} --output {output:q}"
