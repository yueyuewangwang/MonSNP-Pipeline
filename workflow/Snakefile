def selected_chromosomes():
    """Resolve ``all`` from the design-window file while preserving file order."""
    windows = Path(INPUTS["windows"])
    if not windows.is_file():
        raise WorkflowError(
            f"Cannot resolve target_chromosomes because the window file is missing: {windows}. "
            "Generate it with tools/make_windows.py before starting Snakemake."
        )
    available = []
    seen = set()
    with windows.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if not line.strip() or line.startswith("#"):
                continue
            chrom = line.split("\t", 1)[0]
            if chrom not in seen:
                seen.add(chrom)
                available.append(chrom)
    if not available:
        raise WorkflowError(f"No chromosomes were found in the window file: {windows}")

    requested = config.get("target_chromosomes", "all")
    excluded = set(PARAMS.get("exclude_chromosomes", []))
    if requested == "all":
        selected = [chrom for chrom in available if chrom not in excluded]
    else:
        selected = list(requested)
        missing = [chrom for chrom in selected if chrom not in seen]
        blocked = [chrom for chrom in selected if chrom in excluded]
        if missing:
            raise WorkflowError(
                "target_chromosomes contains values absent from inputs.windows: "
                + ", ".join(missing)
            )
        if blocked:
            raise WorkflowError(
                "target_chromosomes also lists excluded chromosomes: " + ", ".join(blocked)
            )
    if not selected:
        raise WorkflowError("No target chromosomes remain after applying exclude_chromosomes")
    return selected


def concatenate_files(paths, output_path, headered=False):
    """Concatenate deterministic chromosome shards, validating repeated headers."""
    output_path = Path(str(output_path))
    output_path.parent.mkdir(parents=True, exist_ok=True)
    expected_header = None
    with output_path.open("w", encoding="utf-8", newline="") as output:
        for path in map(str, paths):
            with open(path, encoding="utf-8", errors="replace") as source:
                if not headered:
                    for line in source:
                        output.write(line)
                    continue
                header = source.readline()
                if not header:
                    raise WorkflowError(f"Headered shard is empty: {path}")
                if expected_header is None:
                    expected_header = header
                    output.write(header)
                elif header != expected_header:
                    raise WorkflowError(f"Header mismatch while gathering chromosome shard: {path}")
                for line in source:
                    output.write(line)


def merge_count_tables(
    paths, output_path, constant_metrics=(), header=("metric", "value")
):
    """Sum two-column counts; require geometry/configuration metrics to agree."""
    constants = set(constant_metrics)
    values = OrderedDict()
    for path in map(str, paths):
        with open(path, encoding="utf-8", newline="") as handle:
            reader = csv.reader(handle, delimiter="\t")
            header = next(reader, None)
            if header is None or len(header) < 2:
                raise WorkflowError(f"Invalid two-column summary: {path}")
            for row in reader:
                if len(row) < 2:
                    continue
                key, value = row[0], row[1]
                if key in constants:
                    if key in values and values[key] != value:
                        raise WorkflowError(f"Inconsistent {key} across chromosome shards")
                    values[key] = value
                else:
                    try:
                        values[key] = str(int(values.get(key, "0")) + int(value))
                    except ValueError as exc:
                        raise WorkflowError(f"Nonnumeric count for {key} in {path}") from exc
    output_path = Path(str(output_path))
    output_path.parent.mkdir(parents=True, exist_ok=True)
    with output_path.open("w", encoding="utf-8") as output:
        output.write(f"{header[0]}\t{header[1]}\n")
        for key, value in values.items():
            output.write(f"{key}\t{value}\n")


